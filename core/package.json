{
  "name": "@opencircuit/core",
  "version": "1.1.0",
  "description": "The Open Circuit Core contains functionality that can be shared across web, VS Code, or Node.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "cross-env IGNORE_API_KEY_TESTS=true NODE_OPTIONS=--experimental-vm-modules jest",
    "test:history-create-race": "npm run build && node ./test/history-create-race.mjs",
    "test:history-save-race": "npm run build && node ./test/history-save-race.mjs",
    "test:providers": "cross-env IGNORE_API_KEY_TESTS=false NODE_OPTIONS=--experimental-vm-modules jest --runTestsByPath llm/llm.integration.test.ts",
    "vitest": "vitest run",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage && open ./coverage/lcov-report/index.html",
    "tsc:check": "tsc -p ./ --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p ./tsconfig.npm.json && node -e \"require('fs').copyFileSync('index.d.ts', 'dist/index.d.ts')\" && node -e \"require('fs').cpSync('tree-sitter', 'dist/tree-sitter', { recursive: true })\"",
    "build:npm": "npm run build",
    "check:install-scripts": "node ../scripts/check-npm-install-scripts.mjs",
    "check:dependency-policy": "node ../scripts/check-dependency-policy.mjs",
    "lint": "eslint . --ext ts",
    "lint:fix": "eslint . --ext ts --fix",
    "test:providers:deletion-gate": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runTestsByPath llm/llm.test.ts"
  },
  "type": "module",
  "author": "Open Circuit",
  "license": "Apache-2.0",
  "devDependencies": {
    "@babel/preset-env": "^7.24.7",
    "@biomejs/biome": "1.6.4",
    "@google/generative-ai": "^0.11.4",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@shikijs/colorized-brackets": "^3.7.0",
    "@shikijs/transformers": "^3.7.0",
    "@types/diff": "^7.0.1",
    "@types/follow-redirects": "^1.14.4",
    "@types/jest": "^29.5.12",
    "@types/jquery": "^3.5.29",
    "@types/jsdom": "^21.1.6",
    "@types/json-schema": "^7.0.15",
    "@types/mozilla-readability": "^0.2.1",
    "@types/mustache": "^4.2.5",
    "@types/node-fetch": "^2.6.11",
    "@types/pg": "^8.11.6",
    "@types/plist": "^3.0.5",
    "@types/request": "^2.48.12",
    "@types/shell-quote": "^1.7.5",
    "@types/tar": "^6.1.13",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.28.2",

{
  "name": "@opencircuit/cli",
  "version": "1.0.1",
  "description": "Open Circuit command-line coding agent",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE.txt",
    "templates"
  ],
  "bin": {
    "oc": "dist/oc.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:runtime-boundary": "node ../../tests/characterization/runtime-boundary-check.mjs",
    "check:release-artifact": "node ../../scripts/check-cli-release-artifact.mjs",
    "release:artifact": "node ../../scripts/package-cli-release.mjs",
    "test:smoke": "node smoke-test.mjs",
    "test:smoke-api": "vitest run --config vitest.smoke-api.config.ts",
    "build:tsc": "tsc -p tsconfig.build.json",
    "build:local-deps": "cd ../.. && npm ci --include=dev && node ./scripts/build-packages.js && cd core && npm ci && npm run build && cd ../extensions/cli && npm ci --include=optional",
    "build:validate": "node validate-aliases.mjs",
    "build:bundle": "node build.mjs",
    "build": "npm run build:validate && npm run build:bundle && npm run build:tsc",
    "check:install-scripts": "node ../../scripts/check-npm-install-scripts.mjs",
    "check:dependency-policy": "node ../../scripts/check-dependency-policy.mjs",
    "start": "node dist/oc.js",
    "dev": "tsx src/index.ts",
    "repomix:cli": "npx repomix --ignore sdk-repomix.xml -o cli-repomix.xml",
    "lint": "tsc --noEmit && eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "watch:logs": "touch ~/.ocircuit/logs/oc.log && tail -f ~/.ocircuit/logs/oc.log",
    "semantic-release": "semantic-release",
    "semantic-release:dry-run": "semantic-release --dry-run"
  },
  "author": "Open Circuit",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-circuit-dev/open-circuit.git"
  },
  "bugs": {
    "url": "https://github.com/open-circuit-dev/open-circuit/issues"
  },
  "homepage": "/",
  "dependencies": {
    "fdir": "^6.4.2",
    "find-up": "^8.0.0",
    "fzf": "^0.5.2",
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@opencircuit/config-yaml": "file:../../packages/config-yaml",
    "@opencircuit/openai-adapters": "file:../../packages/openai-adapters",
    "@opencircuit/sdk": "file:../../packages/sdk",
    "@opencircuit/terminal-security": "file:../../packages/terminal-security",
    "@modelcontextprotocol/sdk": "^1.24.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-fs": "^0.23.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.36.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.3",
    "@semantic-release/npm": "^13.1.5",
    "@testing-library/react": "^16.3.0",
    "@types/date-fns": "^2.5.3",
    "@types/diff": "^7.0.2",
    "@types/express": "^5.0.3",
    "@types/ignore-walk": "^4.0.3",
    "@types/ink-testing-library": "^1.0.4",
    "@types/jszip": "^3.4.0",
    "@types/nock": "^10.0.3",
    "@types/react": "^19.1.8",
    "@types/shell-quote": "^1.7.5",
    "@types/supertest": "^6.0.3",
    "@types/turndown": "^5.0.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/ui": "^5.0.1",
    "@workos-inc/node": "^10.13.0",
    "chalk": "^5.4.1",
    "clipboardy": "^4.0.0",
    "commander": "^14.0.0",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "core": "file:../../core",
    "cross-env": "^7.0.3",
    "date-fns": "^4.1.0",
    "diff": "^8.0.4",
    "dotenv": "^16.5.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "^9.6.0",
    "express": "^5.1.0",
    "gpt-tokenizer": "^3.0.1",
    "gradient-string": "^3.0.0",
    "happy-dom": "^20.0.0",
    "ignore": "^7.0.5",
    "ignore-walk": "^7.0.0",
    "ink": "^6.1.0",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "lowlight": "^3.3.0",
    "minimatch": "^10.0.3",
    "nock": "^14.0.5",
    "node-fetch": "^3.3.2",
    "node-machine-id": "^1.1.12",
    "open": "^10.1.0",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "react": "^19.1.0",
    "semantic-release": "^25.0.9",
    "shell-quote": "^1.8.3",
    "supertest": "^7.1.3",
    "swr": "^2.3.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "turndown": "^7.2.0",
    "typescript": "^5.8.3",
    "uuid": "^14.0.2",
    "vitest": "^5.0.1",
    "winston": "^3.17.0",
    "yaml": "^2.8.0"
  },
  "engines": {
    "node": ">=24.19.0 <27"
  },
  "overrides": {
    "minimatch@<9.0.7": "^9.0.7",
    "qs": "^6.14.2",
    "picomatch": "^4.0.2"
  },
  "optionalDependencies": {
    "@img/sharp-darwin-arm64": "^0.33.5",
    "@img/sharp-darwin-x64": "^0.33.5",
    "@img/sharp-linux-arm": "^0.33.5",
    "@img/sharp-linux-arm64": "^0.33.5",
    "@img/sharp-linux-x64": "^0.33.5",
    "@img/sharp-win32-x64": "^0.33.5"
  },
  "allowScripts": {
    "esbuild@0.25.9": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "unrs-resolver@1.11.1": true,
    "unrs-resolver@1.12.2": true
  }
}
